root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,yml,yaml,json}]
indent_size = 2

[*.cs]
# Always use braces, even for single-line blocks (IDE0011)
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
